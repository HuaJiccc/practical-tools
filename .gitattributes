# 统一换行符：仓库内一律 LF，避免 Windows / macOS 互相产生整文件 diff
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.spec  text eol=lf

# 二进制文件不要做换行转换
*.pyc   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.exe   binary
*.xlsx  binary
